# Stage B: K1 walker training (PROJECT_SPEC B.4) with HTCondor self-checkpointing (exit 85 -> restart+resume).
# Submit from $REMOTE_WORKDIR/cluster after `cluster/pack_code.sh`:   condor_submit submit_train_walker.sub
# Overrides: condor_submit TOTAL=4000 CHUNK=500 ENVS=4096 submit_train_walker.sub
TOTAL = 3000
CHUNK = 500
ENVS = 4096

universe = container
container_image = osdf:///chtc/staging/s/smittal39/k1-follow/containers/isaaclab-2.3.2-k1.sif

executable = run_in_container.sh
arguments = bash train_walker.sh $(TOTAL) $(CHUNK) $(ENVS)
transfer_input_files = train_walker.sh, jobs/code.tar.gz

checkpoint_exit_code = 85
transfer_checkpoint_files = logs
+is_resumable = true

transfer_output_files = walker_logs.tar.gz, walker_export.tar.gz
transfer_output_remaps = "walker_logs.tar.gz = file:///staging/s/smittal39/k1-follow/checkpoints/walker_logs_$(Cluster).tar.gz; walker_export.tar.gz = jobs/out/walker_export_$(Cluster).tar.gz"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

log = jobs/out/train_walker_$(Cluster).log
output = jobs/out/train_walker_$(Cluster).out
error = jobs/out/train_walker_$(Cluster).err
stream_output = true

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.5
gpus_minimum_memory = 10GB
+WantGPULab = true
+GPUJobLength = "medium"
request_cpus = 4
request_memory = 32GB
request_disk = 40GB

queue
