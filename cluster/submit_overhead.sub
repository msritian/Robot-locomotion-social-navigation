# Plumbing test for Part D (zero policy, 10 s): box scene T6 + InteriorGS 839962 T8, with videos.
universe = container
container_image = osdf:///chtc/staging/s/smittal39/k1-follow/containers/isaaclab-2.3.2-k1.sif
executable = run_in_container.sh
arguments = bash overhead.sh
transfer_input_files = overhead.sh, jobs/code.tar.gz
transfer_output_files = overhead.tar.gz
transfer_output_remaps = "overhead.tar.gz = jobs/out/overhead_$(Cluster).tar.gz"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
log = jobs/out/overhead_$(Cluster).log
output = jobs/out/overhead_$(Cluster).out
error = jobs/out/overhead_$(Cluster).err
stream_output = true
requirements = (OpSysMajorVer >= 8) && !regexp("gpu053|cxiaogpu4000|dbrundagegpu5000", Machine)
request_gpus = 1
gpus_minimum_capability = 7.5
gpus_minimum_memory = 10GB
+WantFlocking = true
+WantGlidein = true
request_cpus = 4
request_memory = 16GB
request_disk = 50GB
queue
