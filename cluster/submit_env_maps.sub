# Plumbing test for Part D (zero policy, 10 s): box scene T6 + InteriorGS 839962 T8, with videos.
universe = container
container_image = osdf:///chtc/staging/s/smittal39/k1-follow/containers/isaaclab-2.3.2-k1.sif
executable = run_in_container.sh
arguments = bash env_maps.sh $(NAMES:office hospital warehouse)
transfer_input_files = env_maps.sh, jobs/code.tar.gz
transfer_output_files = env_maps.tar.gz
transfer_output_remaps = "env_maps.tar.gz = jobs/out/env_maps_$(Cluster).tar.gz"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
log = jobs/out/env_maps_$(Cluster).log
output = jobs/out/env_maps_$(Cluster).out
error = jobs/out/env_maps_$(Cluster).err
stream_output = true
requirements = (OpSysMajorVer >= 8) && (Machine =!= "gpu053.chtc.wisc.edu") && (Machine =!= "cxiaogpu4000.chtc.wisc.edu")
request_gpus = 1
gpus_minimum_capability = 7.5
gpus_minimum_memory = 10GB
+WantFlocking = true
+WantGlidein = true
request_cpus = 4
request_memory = 16GB
request_disk = 50GB
queue
