# Plumbing test for Part D (zero policy, 10 s): box scene T6 + InteriorGS 839962 T8, with videos.
universe = container
container_image = osdf:///chtc/staging/s/smittal39/k1-follow/containers/isaaclab-2.3.2-k1.sif
executable = run_in_container.sh
arguments = bash plumb.sh
transfer_input_files = plumb.sh, isaac_eval.sh, jobs/code.tar.gz, jobs/k1_walker.pt
transfer_output_files = d_out.tar.gz
transfer_output_remaps = "d_out.tar.gz = jobs/out/d_out_plumb_$(Cluster).tar.gz"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
log = jobs/out/isaac_plumb_$(Cluster).log
output = jobs/out/isaac_plumb_$(Cluster).out
error = jobs/out/isaac_plumb_$(Cluster).err
stream_output = true
requirements = (OpSysMajorVer >= 8) && !regexp("gpu053|cxiaogpu4000|dbrundagegpu5000", Machine)
request_gpus = 1
gpus_minimum_capability = 7.5
gpus_minimum_memory = 10GB
+WantFlocking = true
+WantGlidein = true
request_cpus = 4
request_memory = 20GB
request_disk = 50GB
queue
