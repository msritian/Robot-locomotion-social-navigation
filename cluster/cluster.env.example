# Copy to cluster/cluster.env (gitignored) and fill in. Nothing here is guessed; every script
# in cluster/ reads these values and refuses to run if a required one is empty.

# --- login / submit node ---
CLUSTER_HOST=""            # e.g. submit node hostname
CLUSTER_USER=""            # your username on the cluster
SSH_OPTS=""                # optional extra ssh options (e.g. -i ~/.ssh/id_ed25519)

# --- storage ---
REMOTE_WORKDIR=""          # where the code is synced to (home / project dir)
REMOTE_BIGDATA=""          # large-file storage: containers, Isaac asset cache, checkpoints, videos

# --- scheduler ---
SCHEDULER=""               # htcondor | slurm | other
GPU_REQUEST=""             # how GPUs are requested (e.g. HTCondor: request_gpus = 1 + gpus_minimum_memory ...)
GPU_MODELS_TRAIN=""        # GPU models acceptable for headless training (Stage B)
GPU_MODELS_RENDER=""       # RTX-class GPUs with RT cores for rendering (Stage D), empty if none
JOB_TIME_LIMIT_H=""        # max wall time per job (hours)

# --- containers ---
CONTAINER_RUNTIME=""       # docker | apptainer | singularity
ISAACLAB_IMAGE=""          # pinned image (filled in after we check Booster/Isaac Lab compatibility)
COMPUTE_NODES_HAVE_INTERNET=""   # yes | no
