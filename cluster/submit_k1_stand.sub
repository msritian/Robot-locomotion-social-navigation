# M1: K1 asset stand test (10 s holding the walking default pose). condor_submit submit_k1_stand.sub
universe = container
container_image = osdf:///chtc/staging/s/smittal39/k1-follow/containers/isaaclab-2.3.2-k1.sif
executable = run_in_container.sh
arguments = bash k1_stand.sh
transfer_input_files = k1_stand.sh, jobs/code.tar.gz
transfer_output_files = stand_out.tar.gz
transfer_output_remaps = "stand_out.tar.gz = jobs/out/stand_out_$(Cluster).tar.gz"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
log = jobs/out/k1_stand_$(Cluster).log
output = jobs/out/k1_stand_$(Cluster).out
error = jobs/out/k1_stand_$(Cluster).err
stream_output = true
requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.5
gpus_minimum_memory = 10GB
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 24GB
request_disk = 40GB
queue
